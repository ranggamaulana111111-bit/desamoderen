# Prodesa Docker configuration
# Salin file ini menjadi .env di direktori project lalu sesuaikan nilainya.
# docker compose akan membacanya untuk mengganti default pada docker-compose.yml

# URL aplikasi dan port web host
APP_URL=http://localhost
APP_PORT=80

# Kunci aplikasi Laravel — GENERATE SEKALI lalu simpan di sini:
#   php artisan key:generate --show
# Jika dikosongkan, entrypoint akan membuat kunci sementara (berubah tiap restart).
APP_KEY=

# Kredensial database
DB_DATABASE=prodesa
DB_USERNAME=prodesa
DB_PASSWORD=prodesa
DB_ROOT_PASSWORD=prodesa_root
DB_PORT_EXPOSE=3306

# API key Gemini (untuk FAQ asisten) — opsional
GEMINI_API_KEY=
